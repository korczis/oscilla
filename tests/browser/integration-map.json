{
  "note": "K075 integration map. `rows` are derived by tests/browser/lib/integration-map.mjs (run it to rewrite them; --check, in npm test, fails when they are stale or the scan refuses); every other key is written by hand. tests/browser/integration-map.cjs walks every row.",
  "kinds": {
    "open-in": "opens the subject in another workspace or instrument (a Studio template, the same document in Studio)",
    "send-to": "sends content to another workspace, which converts it",
    "modulation-route": "routes a modulation source to a parameter of another instrument",
    "probe": "attaches a view to a signal of another instrument",
    "jump": "opens another workspace, or makes a link to this state"
  },
  "absent": [
    {
      "kind": "modulation-route",
      "issue": "K076",
      "why": "no control routes a modulation source across instruments on this base (Modulate this knob)"
    },
    {
      "kind": "probe",
      "issue": "K064, K086",
      "why": "no probe card or jack probe exists on this base"
    }
  ],
  "writers": [
    {
      "id": "dispatcher",
      "why": "the one hash dispatcher (ui/navigation.js write and its load stamp): every workspace route goes through it"
    },
    {
      "id": "measure-loopback-param",
      "why": "keeps ?measure=loopback (TEST CONTEXT) in step with the page; a query parameter, no route"
    }
  ],
  "reloadDebt": [
    {
      "row": "synth > page.relatedLink > studio",
      "issue": "V604",
      "why": "the Studio document lives in memory: a reload of #m=studio opens the default template, so the voice the Synth instantiated (or the converted pattern) is gone; V604 saves the working draft and restores it"
    },
    {
      "row": "synth > synth.studio > studio",
      "issue": "V604",
      "why": "the Studio document lives in memory: a reload of #m=studio opens the default template, so the voice the Synth instantiated (or the converted pattern) is gone; V604 saves the working draft and restores it"
    },
    {
      "row": "sequencer > seq.toStudio > studio",
