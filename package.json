{
  "name": "oscilla",
  "version": "2.0.1",
  "private": true,
  "description": "OSCILLA - Interactive Sound & Frequency Lab. Builds into one static dist/index.html.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "build:debug": "node scripts/build.mjs --debug",
    "verify-dist": "node scripts/verify-dist.mjs",
    "version:check": "node scripts/release-version-check.mjs",
    "verify": "npm test && npm run version:check && npm run build:check && npm run verify-dist && majordomus doctor",
    "release:analyze": "node scripts/release-analyze.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:stamp": "node scripts/stamp-build.mjs",
    "release:verify-deploy": "node scripts/verify-deploy.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:browser": "node tests/browser/app.cjs && node tests/browser/layout.cjs && node tests/browser/qa-regressions.cjs",
    "test:dsp": "node tests/browser/dsp.cjs",
    "test:labs": "node tests/browser/labs.cjs",
    "test:sequencer": "node tests/browser/sequencer.cjs",
    "test:visual": "node scripts/visual-gate.mjs dist",
    "test:live": "node tests/browser/live-smoke.cjs",
    "test:release": "npm run test:engine && npm run test:dsp && npm run test:labs && npm run test:sequencer && npm run test:browser && npm run test:visual",
    "release-gate": "npm run verify && npm run test:release",
    "visual": "node scripts/visual-compare.mjs dist --play --out tests/visual/out-integration",
    "test:engine": "node tests/browser/engine-v1port.cjs",
    "social": "node scripts/social-assets.mjs"
  },
  "dependencies": {
    "alpinejs": "3.14.9",
    "p5": "1.11.3",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lucide-static": "1.49.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0"
  }
}
